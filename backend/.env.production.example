# ENVIRONNEMENT DE PRODUCTION — copier vers .env et FORGER chaque secret.
# DEBUG doit rester false : l'application refuse de démarrer avec une SECRET_KEY faible.

DEBUG=false
SECRET_KEY=REMPLACER_PAR_UNE_CLE_FORTE_ALEATOIRE

# Base de données
DATABASE_URL=postgresql+asyncpg://admin:CHANGER_MOT_DE_PASSE@<hote>:5432/risk_agents

# Redis / Celery (files d'attente)
REDIS_URL=redis://<hote>:6379
CELERY_BROKER_URL=redis://<hote>:6379/0
CELERY_RESULT_BACKEND=redis://<hote>:6379/1

# LLM (Opencode Go)
LLM_PROVIDER=opencode_go
LLM_MODEL=deepseek-v4-pro
LLM_ENDPOINT_URL=https://opencode.ai/inference/openai/v1/chat/completions
LLM_API_KEY=REMPlACER_PAR_LA_CLE

# CORS (liste séparée par des virgules)
CORS_ORIGINS=https://<domaine_frontend>